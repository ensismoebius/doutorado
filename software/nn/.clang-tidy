Checks: >
  -*,

  # =====================================================
  # CORE SAFETY (ALTO VALOR, BAIXO RUÍDO)
  # =====================================================
  clang-analyzer-*,
  bugprone-*,
  performance-*,

  # =====================================================
  # MODERN C++ (SEGURO PARA HPC)
  # =====================================================
  modernize-*,

  # =====================================================
  # READABILITY (COM EXCLUSÕES NUMÉRICAS)
  # =====================================================
  readability-*,

  # =====================================================
  # DESABILITADOS — RUÍDO / FALSOS POSITIVOS
  # =====================================================
  - misc-*,
  - readability-identifier-length,
  - readability-magic-numbers,
  - bugprone-easily-swappable-parameters,

  # =====================================================
  # CPP CORE GUIDELINES — HPC / EIGEN / CUDA
  # =====================================================
  - cppcoreguidelines-non-private-member-variables-in-classes,
  - cppcoreguidelines-pro-bounds-pointer-arithmetic,
  - cppcoreguidelines-pro-type-reinterpret-cast,
  - cppcoreguidelines-owning-memory,
  - cppcoreguidelines-no-malloc,
  - cppcoreguidelines-avoid-magic-numbers,

  # =====================================================
  # CPP CORE GUIDELINES — SEGUROS EM PESQUISA
  # =====================================================
  cppcoreguidelines-pro-bounds-*,
  cppcoreguidelines-pro-type-*,
  cppcoreguidelines-init-variables,

  # =====================================================
  # PERFORMANCE NUMÉRICA (ALTO IMPACTO)
  # =====================================================
  performance-inefficient-vector-operation,
  performance-for-range-copy,
  performance-unnecessary-value-param,

  # =====================================================
  # MODERNIZE — ESTILO OPCIONAL (SEM IMPACTO NUMÉRICO)
  # =====================================================
  modernize-use-trailing-return-type,
  modernize-use-auto,
  modernize-use-using,
  modernize-avoid-c-arrays

WarningsAsErrors: ""
HeaderFilterRegex: ".*(src|include)/(cpu|common)/.*"
FormatStyle: file
