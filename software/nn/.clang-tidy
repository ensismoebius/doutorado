Checks: >
  -*,

  # =====================================================
  # CORE SAFETY (ALTO VALOR, BAIXO RUÍDO)
  # =====================================================
  clang-analyzer-*,
  bugprone-*,
  performance-*,

  # =====================================================
  # MODERN C++ (SEGURO PARA HPC)
  # =====================================================
  modernize-*,

  # =====================================================
  # READABILITY (COM EXCLUSÕES NUMÉRICAS)
  # =====================================================
  readability-*,


  # =====================================================
  # CPP CORE GUIDELINES — SEGUROS EM PESQUISA
  # =====================================================
  cppcoreguidelines-pro-bounds-*,
  cppcoreguidelines-pro-type-*,
  cppcoreguidelines-init-variables,

  # =====================================================
  # PERFORMANCE NUMÉRICA (ALTO IMPACTO)
  # =====================================================
  performance-inefficient-vector-operation,
  performance-for-range-copy,
  performance-unnecessary-value-param,

  # =====================================================
  # MODERNIZE — ESTILO OPCIONAL (SEM IMPACTO NUMÉRICO)
  # =====================================================
  modernize-use-trailing-return-type,
  modernize-use-auto,
  modernize-use-using,
  modernize-avoid-c-arrays

WarningsAsErrors: ""
HeaderFilterRegex: "^(?!.*\\/build\\/).*/(src|include)/.*"
FormatStyle: file
