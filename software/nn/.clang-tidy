Checks: >
  # =====================================================
  # REMOVE ALL CONFIGURATIONS
  # =====================================================
  -*,

  # =====================================================
  # CORE SAFETY (ALTO VALOR, BAIXO RUÍDO)
  # =====================================================
  bugprone-*,
  clang-analyzer-*,

  # =====================================================
  # MODERN C++ (SEGURO PARA HPC)
  # =====================================================
  modernize-*,

  # =====================================================
  # READABILITY (COM EXCLUSÕES NUMÉRICAS)
  # =====================================================
  readability-*,

  # =====================================================
  # PERFORMANCE NUMÉRICA (ALTO IMPACTO)
  # =====================================================
  performance-*,

  # =====================================================
  # CPP CORE GUIDELINES — SEGUROS EM PESQUISA
  # =====================================================
  cppcoreguidelines-*,

  # =====================================================
  # EXCLUSÕES PARA EVITAR FALSO POSITIVOS
  # =====================================================
  -misc-*,
  -cppcoreguidelines-non-private-member-variables-in-classes,
  -readability-identifier-length,
  -readability-magic-numbers,
  -bugprone-easily-swappable-parameters

WarningsAsErrors: ""
HeaderFilterRegex: "^(?!.*\\/build\\/).*/(src|include)/.*"
FormatStyle: file
