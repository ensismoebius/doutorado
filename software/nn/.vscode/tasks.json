{
	"version": "2.0.0",
	"tasks": [
		{
			"label": "cppcheck (aggressive)",
			"type": "process",
			"command": "cppcheck",
			"args": [
				"--enable=all",
				"--check-level=exhaustive",
				"--std=c++20",
				"--platform=native",
				"--suppress=missingIncludeSystem",
				"--suppress=unusedFunction",
				"--quiet",
				"--xml",
				"--output-file=cppcheck.xml",
				"src/"
			]
		},
		{
			"label": "flawfinder (security)",
			"type": "process",
			"command": "flawfinder",
			"args": [
				"--minlevel=1",
				"--columns",
				"--singleline",
				"src/"
			],
			"problemMatcher": {
				"owner": "flawfinder",
				"pattern": {
					"regexp": "^(.*):(\\d+):(\\d+):\\s+\\[(\\d+)\\]\\s+(.*)$",
					"file": 1,
					"line": 2,
					"column": 3,
					"message": 5
				}
			}
		},
		{
			"label": "analise_codebase",
			"dependsOn": [
				"cppcheck (aggressive)",
				"flawfinder (security)",
				"CMake: build"
			],
			"dependsOrder": "sequence",
			"group": {
				"kind": "build",
				"isDefault": true
			}
		},
		{
			"label": "cmake_config",
			"type": "shell",
			"command": "cmake",
			"args": [
