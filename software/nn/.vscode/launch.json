{
    "version": "0.2.0",
    "configurations": [
        // ─────────────────────────────────────────────────────────────────
        // Generic: debug whichever target is selected in the CMake toolbar.
        // Select a target in the bottom status bar, then press F5.
        // ─────────────────────────────────────────────────────────────────
        {
            "name": "CMake: active target (lldb-dap)",
            "type": "lldb-dap",
            "request": "launch",
            "program": "${command:cmake.launchTargetPath}",
            "args": [],
            "cwd": "${workspaceFolder}",
            "initCommands": [
                "command script import ${workspaceFolder}/debug/lldb/eigenlldb.py"
            ],
            "env": {
                "ASAN_OPTIONS": "detect_leaks=0",
                "LSAN_OPTIONS": "verbosity=1:log_threads=1"
            }
        },
