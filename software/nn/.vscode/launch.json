{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "CMake Debug (LLDB DAP)",
            "type": "lldb-dap",
            "request": "launch",
            "program": "${command:cmake.launchTargetPath}",
            "cwd": "${command:cmake.launchTargetDirectory}",
            "args": [
                "${workspaceFolder}/src/experiments/config.yaml"
            ],
            "console": "internalConsole",
            "preLaunchTask": "analise_codebase",
            "initCommands": [
                "script import sys, os, importlib",
                "script sys.path.insert(0, '${workspaceFolder}/debug/lldb')",
                "script import eigenlldb",
                "script importlib.reload(eigenlldb)",
                "script eigenlldb.__lldb_init_module(lldb.debugger, None)"
            ],
            "stopOnEntry": false
        }
    ]
}