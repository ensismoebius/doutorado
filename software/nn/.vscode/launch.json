{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Python Debugger: Current File",
            "type": "debugpy",
            "request": "launch",
            "program": "${file}",
            "console": "integratedTerminal",
            "args": [
                "demo"
            ]
        },
        {
            "name": "Run: demo",
            "type": "debugpy",
            "request": "launch",
            "module": "app.main",
            "cwd": "${workspaceFolder}/src/demos/pydemos",
            "console": "integratedTerminal",
            "args": [
                "demo",
                "--duracao",
                "1.0",
                "--saida-plot",
                "debug_demo.png"
            ]
        },
        {
            "name": "Run: capturar",
            "type": "debugpy",
            "request": "launch",
            "module": "app.main",
            "cwd": "${workspaceFolder}/src/demos/pydemos",
            "console": "integratedTerminal",
            "args": [
                "capturar",
                "--pessoa",
                "alice",
                "--duracao",
                "3.0"
            ]
        },
        {
            "name": "Run: treinar",
            "type": "debugpy",
            "request": "launch",
            "module": "app.main",
            "cwd": "${workspaceFolder}/src/demos/pydemos",
            "console": "integratedTerminal",
            "args": [
                "treinar",
                "--epocas",
                "5",
                "--saida-modelo",
                "debug_model.pt"
            ]
        },
        {
            "name": "Run: identificar",
            "type": "debugpy",
            "request": "launch",
            "module": "app.main",
            "cwd": "${workspaceFolder}/src/demos/pydemos",
            "console": "integratedTerminal",
            "args": [
                "identificar"
            ]
        },
        {
            "name": "Run: verificar",
            "type": "debugpy",
            "request": "launch",
            "module": "app.main",
            "cwd": "${workspaceFolder}/src/demos/pydemos",
            "console": "integratedTerminal",
            "args": [
                "verificar"
            ]
        },
        {
            "name": "Run: avaliar",
            "type": "debugpy",
            "request": "launch",
            "module": "app.main",
            "cwd": "${workspaceFolder}/src/demos/pydemos",
            "console": "integratedTerminal",
            "args": [
                "avaliar",
                "--diretorio-dados",
                "dados/vozes"
            ]
        },
        {
            "name": "CMake Debug (LLDB DAP)",
            "type": "lldb-dap",
            "request": "launch",
            "program": "${command:cmake.launchTargetPath}",
            "cwd": "${command:cmake.launchTargetDirectory}",
            "args": [
                "${workspaceFolder}/src/experiments/config.yaml"
            ],
            "console": "internalConsole",
            "preLaunchTask": "analise_codebase",
            "initCommands": [
                "script import sys, os, importlib",
                "script sys.path.insert(0, '${workspaceFolder}/debug/lldb')",
                "script import eigenlldb",
                "script importlib.reload(eigenlldb)",
                "script eigenlldb.__lldb_init_module(lldb.debugger, None)"
            ],
            "stopOnEntry": false
        }
    ]
}