{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "CMake Debug (LLDB DAP)",
            "type": "lldb",
            "request": "launch",
            "program": "${command:cmake.launchTargetPath}",
            "cwd": "${command:cmake.launchTargetDirectory}",
            "args": [
                "${workspaceFolder}/src/experiments/config.yaml"
            ],
            "console": "internalConsole",
            "preLaunchTask": "CMake: build",
            "initCommands": [
                "script import sys, os, importlib",
                "script sys.path.insert(0, '${workspaceFolder}/debug/lldb')",
                "script import eigenlldb",
                "script importlib.reload(eigenlldb)",
                "script eigenlldb.__lldb_init_module(lldb.debugger, None)"
            ],
            "stopOnEntry": false
        },
        // Uncomment the following configuration to use GDB instead of LLDB
        // {
        //     "name": "CMake Debug (GDB)",
        //     "type": "cppdbg",
        //     "request": "launch",
        //     "program": "${workspaceFolder}/build/main_test02",
        //     "args": [],
        //     "stopAtEntry": false,
        //     "cwd": "${workspaceFolder}/build",
        //     "MIMode": "gdb",
        //     "setupCommands": [
        //         {
        //             "description": "Enable pretty-printing for gdb",
        //             "text": "-enable-pretty-printing",
        //             "ignoreFailures": true
        //         },
        //         {
        //             "description": "Catch C++ exceptions",
        //             "text": "catch throw"
        //         },
        //         {
        //             "description": "Load custom pretty printers",
        //             "text": "source ${workspaceFolder}/debug/gdb/printers.py"
        //         }
        //     ]
        // }
    ]
}