# .clangd - compile database + compile flags + clang-tidy checks
CompileFlags:
  # use o compile_commands.json dentro de build/
  CompilationDatabase: build

  # flags adicionadas SOMENTE quando não existirem no compile_commands.json
  Add:
    - -std=gnu++20

    # includes do seu projeto
    - -I${workspaceFolder}/src

    # Eigen (include root correto no Arch)
    - -isystem
    - /usr/include/eigen3

    # alinhar toolchain
    - --gcc-toolchain=/usr

Index:
  Background: Build # indexação em background
  Threads: 0 # 0 = auto (use CPU disponível)
  StorePreamble: true
