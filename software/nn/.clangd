# --------------------------------------------------
# .clangd — merged & tuned for HPC / embedded / research
# --------------------------------------------------

CompileFlags:
  # Use compile_commands.json from your custom build dir
  CompilationDatabase: out/build/max-performance-macos

  # Drop PCH flags for editor parsing; they can trigger false include errors.
  Remove:
    - -Winvalid-pch
    - -include

  # Added only if not present in compile_commands.json
  Add:
    - -std=gnu++20
    - -Iinclude
    - -Isrc
    - -Isrc/experiments/autoencoderRunner/lib/include
    - -Isrc/experiments/autoencoderRunner/lib/include/autoencoder
    - -Isrc/experiments/guayaquil/lib/include
    - -isystem
    - /usr/include/eigen3
    - --gcc-toolchain=/usr
    - -Wall
    - -Wno-unused-parameter
    - -Wno-unused-variable

Index:
  Background: Build