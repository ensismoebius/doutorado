FROM ubuntu:22.04
ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update && apt-get install -y \
    build-essential cmake ninja-build git pkg-config \
    autoconf automake libtool m4 ca-certificates \
    libeigen3-dev libblas-dev liblapack-dev libopenblas-dev \
    libhdf5-dev libsdl2-dev libgl1-mesa-dev libglu1-mesa-dev \
    libxrandr-dev libxinerama-dev libxcursor-dev libxi-dev \
    libfftw3-dev libfftw3-mpi-dev libopenmpi-dev clang-tidy cppcheck \
    flawfinder valgrind ccache python3 python3-dev python3-venv python3-pip \
    lcov gcovr doxygen curl wget unzip && \
    rm -rf /var/lib/apt/lists/*

WORKDIR /work

CMD ["/bin/bash"]
