FROM ubuntu:22.04
ENV DEBIAN_FRONTEND=noninteractive

# Bootstrap tools needed to run `cmake ..` inside the container: the compiler,
# cmake/ninja, git (vendored deps), pkg-config and the autotools stack (vendored
# NFFT3) plus ca-certificates for the FetchContent downloads. Everything else the
# build needs (eigen, openblas, sdl2, fftw, hdf5, glfw, omp, OpenCL headers/
# loader, sqlite, zlib) is installed by cmake/UbuntuDependencies.cmake at
# Configure time. Only CI tooling (analysis/security/coverage/python) and the
# OpenCL CPU runtime (pocl) are baked in.
RUN apt-get update && apt-get install -y \
    build-essential cmake ninja-build git pkg-config \
    autoconf automake libtool m4 ca-certificates \
    clang-tidy cppcheck flawfinder valgrind ccache \
    python3 python3-dev python3-venv python3-pip \
    lcov gcovr doxygen curl wget unzip pocl-opencl-icd && \
    rm -rf /var/lib/apt/lists/*

WORKDIR /work

CMD ["/bin/bash"]
