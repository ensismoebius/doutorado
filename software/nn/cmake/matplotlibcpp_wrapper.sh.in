#!/usr/bin/env bash
# Wrapper generated by CMake to ensure a venv-provided site-packages
# are available to embedded Python used by matplotlib-cpp.

VENV_DIR="@CMAKE_BINARY_DIR@/_deps/matplotlib-cpp-venv"
PY_BIN="${VENV_DIR}/bin/python"

if [ -x "${PY_BIN}" ]; then
  # getsitepackages() may return a list; print the first element
  SITE_PACKAGES="$(${PY_BIN} -c 'import site; print(site.getsitepackages()[0])')"
  export PYTHONPATH="${SITE_PACKAGES}:${PYTHONPATH:-}"
fi

export MPLCONFIGDIR="${TMPDIR:-/tmp}/matplotlib_cpp_config"

# Determine the real binary (the built binary will be renamed to *.real)
SELF="$(readlink -f "$0")"
REAL_BIN="${SELF}.real"

exec "${REAL_BIN}" "$@"
