{
  "run_tag": "pga_debug",
  "results_dir": "results/paraconsistentGA/smoke",
  "experiment": {
    "seed": 42
  },
  "dataset": {
    "root": "~/database.sqlite",
    "modality": "eeg",
    "eeg_condition": "pronounced",
    "max_samples": 40
  },
  "feature_extraction": {
    "strategy": "autoencoder",
    "autoencoder": {
      "model": "ann-ae",
      "ae_loss_type": "mse"
    }
  },
  "paraconsistent": {
    "enabled": true,
    "speaker_subsets": false
  },
  "classifier": {
    "enabled": false
  },
  "training": {
    "epochs": 3,
    "learning_rate": 0.001,
    "samples_per_batch": 16,
    "optimizer_type": "adam",
    "gradient_clip_norm": 0.0
  },
  "ga": {
    "population_size": 6,
    "generations": 2,
    "n_seeds": 1,
    "crossover_prob": 0.9,
    "mutation_prob": 0.3,
    "seed": 42,
    "tournament_k": 2,
    "bounds": {
      "min_layers": 1,
      "max_layers": 6,
      "min_width": 1,
      "max_width": 128
    },
    "n_losers": 2
  },
  "constraints": {
    "latency_ceiling_ms": 1000.0,
    "fixed_pipeline_cost_ms": 0.0,
    "latency_calibrated": false,
    "ns_per_mac": 2.0,
    "tau_rec": 0.0001
  },
  "checkpoint": {
    "enabled": true,
    "every_generations": 1
  }
}
