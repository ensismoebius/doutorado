{
  "experiment": {
    "run_tag": "smoke_e05_p00_ae_ann_tiny_voice",
    "seed": 42,
    "repeats": 1
  },
  "dataset": {
    "root": "~/database.sqlite",
    "results_dir": "results/thesis/smoke",
    "modality": "voice",
    "max_samples": 60
  },
  "feature_extraction": {
    "strategy": "autoencoder",
    "autoencoder": {
      "model": "ann-ae",
      "encoder_layer_spec": [
        "linear:16:leaky",
        "linear:8:identity"
      ],
      "decoder_layer_spec": [
        "linear:16:leaky",
        "linear:output:identity"
      ],
      "ae_loss_type": "mse"
    }
  },
  "paraconsistent": {
    "enabled": true,
    "speaker_subsets": true,
    "fold_k": 5,
    "fold_seed": 42,
    "fold_repeats": 3
  },
  "classifier": {
    "enabled": false
  },
  "training": {
    "epochs": 2,
    "learning_rate": 0.001,
    "samples_per_batch": 4,
    "optimizer_type": "adam",
    "gradient_clip_norm": 0.0
  }
}
