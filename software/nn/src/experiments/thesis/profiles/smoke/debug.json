{
  "experiment": {
    "run_tag": "smoke_e05_debug",
    "seed": 42,
    "repeats": 1
  },
  "dataset": {
    "root": "~/database.sqlite",
    "results_dir": "results/thesis/smoke",
    "modality": "eeg",
    "max_samples": 120
  },
  "feature_extraction": {
    "strategy": "handcrafted",
    "handcrafted": {
      "transform": "dtwpt",
      "scale": "lfcc",
      "descriptors": [
        "energy",
        "zcr"
      ],
      "dtwpt_level": 3,
      "wavelet": "daub4",
      "cepstral": false
    }
  },
  "paraconsistent": {
    "enabled": true
  },
  "classifier": {
    "type": "rnn",
    "layer_spec": [
      "linear:64:relu",
      "residual:1",
      "linear:N_speakers:identity"
    ],
    "text_mode": "dependent",
    "enabled": true
  },
  "training": {
    "epochs": 2,
    "learning_rate": 0.001,
    "samples_per_batch": 4,
    "early_stop_patience": 1,
    "k_folds": 2,
    "nested_cv": true,
    "weight_decay": 0.0001,
    "optimizer_type": "adam",
    "gradient_clip_norm": 0.0,
    "standardize_features": true
  }
}
