{
  "experiment": {
    "run_tag": "e05_p01_dsnn_eeg_indep_flat_std",
    "seed": 42,
    "repeats": 3,
    "seed_deterministic": false
  },
  "dataset": {
    "root": "~/database.sqlite",
    "results_dir": "results/thesis/phase01",
    "modality": "eeg"
  },
  "feature_extraction": {
    "strategy": "handcrafted",
    "handcrafted": {
      "transform": "dtwpt",
      "scale": "lfcc",
      "wavelet": "haar",
      "cepstral": false,
      "descriptors": [
        "energy",
        "zcr",
        "entropy",
        "teager",
        "jitter",
        "shimmer"
      ],
      "dtwpt_level": 4
    }
  },
  "paraconsistent": {
    "enabled": false
  },
  "classifier": {
    "type": "dsnn",
    "layer_spec": [
      "linear:128:relu",
      "residual:2",
      "linear:N_speakers:identity"
    ],
    "text_mode": "independent",
    "enabled": true
  },
  "training": {
    "epochs": 50,
    "learning_rate": 0.001,
    "samples_per_batch": 32,
    "early_stop_patience": 10,
    "k_folds": 5,
    "nested_cv": false,
    "standardize_features": true
  }
}
