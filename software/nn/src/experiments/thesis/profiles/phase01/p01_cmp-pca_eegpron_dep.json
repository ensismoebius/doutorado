{
  "experiment": {
    "run_tag": "e05_p01_cmp-pca_eegpron_dep",
    "seed": 42,
    "repeats": 3,
    "seed_deterministic": false
  },
  "dataset": {
    "root": "~/database.sqlite",
    "results_dir": "results/thesis/phase01",
    "modality": "eeg",
    "eeg_condition": "pronounced",
    "max_samples": 0
  },
  "feature_extraction": {
    "strategy": "pca",
    "pca": {
      "n_components": 8
    }
  },
  "paraconsistent": {
    "enabled": false
  },
  "classifier": {
    "type": "dsnn",
    "layer_spec": [
      "linear:128:relu",
      "residual:2",
      "linear:N_speakers:identity"
    ],
    "text_mode": "dependent",
    "enabled": true
  },
  "training": {
    "k_folds": 5,
    "nested_cv": false,
    "standardize_features": true,
    "epochs": 100,
    "learning_rate": 0.001,
    "samples_per_batch": 32,
    "optimizer_type": "adam",
    "gradient_clip_norm": 0.0,
    "weight_decay": 0.0,
    "firing_rate_reg_lambda": 0.0,
    "batch_normalization": "none"
  }
}
