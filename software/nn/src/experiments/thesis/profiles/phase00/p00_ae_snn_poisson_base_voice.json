{
  "experiment": {
    "run_tag": "e05_p00_ae_snn_poisson_base_voice",
    "seed": 42,
    "repeats": 3,
    "seed_deterministic": false
  },
  "dataset": {
    "root": "~/database.sqlite",
    "results_dir": "results/thesis/phase00",
    "modality": "voice",
    "max_samples": 0
  },
  "feature_extraction": {
    "strategy": "autoencoder",
    "autoencoder": {
      "model": "snn-ae",
      "encoder_layer_spec": [
        "linear:64:leaky",
        "linear:32:identity"
      ],
      "decoder_layer_spec": [
        "linear:64:leaky",
        "linear:output:identity"
      ],
      "encoding": "poisson",
      "time_steps": 16,
      "voltage_threshold": 0.2,
      "firing_rate_reg_lambda": 0.5,
      "firing_rate_min": 0.1,
      "firing_rate_max": 0.8,
      "ae_loss_type": "mse"
    }
  },
  "paraconsistent": {
    "enabled": true
  },
  "classifier": {
    "enabled": false
  },
  "training": {
    "epochs": 100,
    "learning_rate": 0.001,
    "samples_per_batch": 32,
    "optimizer_type": "adam",
    "gradient_clip_norm": 0.0
  }
}
