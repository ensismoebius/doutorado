{
  "experiment": {
    "run_tag": "e05_debug",
    "seed": 42,
    "repeats": 1
  },
  "dataset": {
    "root": "~/database.sqlite",
    "results_dir": "results/thesis/debug",
    "modality": "eeg",
    "eeg_condition": "pronounced",
    "max_samples": 60
  },
  "feature_extraction": {
    "strategy": "handcrafted",
    "handcrafted": {
      "transform": "dtwpt",
      "scale": "lfcc",
      "descriptors": [
        "energy",
        "zcr"
      ],
      "dtwpt_level": 3,
      "wavelet": "daub4",
      "cepstral": false
    }
  },
  "paraconsistent": {
    "enabled": true,
    "speaker_subsets": false
  },
  "classifier": {
    "type": "ann",
    "layer_spec": [
      "linear:64:relu",
      "residual:1",
      "linear:N_speakers:identity"
    ],
    "text_mode": "dependent",
    "enabled": true
  },
  "training": {
    "epochs": 3,
    "learning_rate": 0.001,
    "samples_per_batch": 8,
    "early_stop_patience": 2,
    "k_folds": 2,
    "nested_cv": true,
    "weight_decay": 0.0001,
    "optimizer_type": "adam",
    "gradient_clip_norm": 0.0,
    "standardize_features": true
  }
}
