{
  "experiment": {
    "run_tag": "e05_bx01_ann_eegpron_indep_flat_std",
    "seed": 42,
    "repeats": 3,
    "seed_deterministic": false
  },
  "dataset": {
    "source": "biomex2021",
    "root": "~/biomex.sqlite",
    "results_dir": "results/thesis/biomex",
    "modality": "eeg",
    "eeg_condition": "pronounced",
    "max_samples": 0
  },
  "feature_extraction": {
    "strategy": "handcrafted",
    "handcrafted": {
      "transform": "dtwpt",
      "scale": "lfcc",
      "wavelet": "haar",
      "cepstral": false,
      "descriptors": [
        "energy",
        "zcr",
        "entropy",
        "teager",
        "jitter",
        "shimmer"
      ],
      "dtwpt_level": 4
    }
  },
  "paraconsistent": {
    "enabled": false
  },
  "classifier": {
    "type": "ann",
    "layer_spec": [
      "linear:128:relu",
      "residual:2",
      "linear:N_speakers:identity"
    ],
    "text_mode": "independent",
    "enabled": true
  },
  "training": {
    "k_folds": 5,
    "nested_cv": false,
    "standardize_features": true,
    "epochs": 50,
    "learning_rate": 0.001,
    "samples_per_batch": 32,
    "optimizer_type": "adam",
    "gradient_clip_norm": 0.0,
    "weight_decay": 0.0
  }
}
