{
  "neural_network_audio_features": 0,
  "neural_network_depth": 1,
  "neural_network_eeg_features": 0,
  "neural_network_hidden_size": 16,
  "neural_network_input_features": 0,
  "neural_network_latent_size": 8,
  "neural_network_layer_sizes": [
    16
  ],
  "neural_network_type": "fused-window-ann",
  "training_batch_size": 4,
  "dataset_type": "fused-window",
  "training_max_batches_per_epoch": 20,
  "program_prefetch_lookahead": 1,
  "training_epochs": 1,
  "training_learning_rate": 0.001,
  "dataset_subject_filter_regex": "^S(\\d+)$",
  "dataset_root_path": "~/database.sqlite",
  "training_optimizer_type": "adam",
  "training_loss_type": "mse",
  "training_lr_plateau_enabled": true,
  "training_lr_plateau_factor": 0.5,
  "training_lr_plateau_patience": 3,
  "training_lr_plateau_min_delta": 0.000001,
  "training_normalize_inputs": true,
  "validation_modality_diagnostics_enabled": true,
  "neural_network_layer": [
    "encoder:linear:16:relu",
    "encoder:linear:latent:relu",
    "decoder:linear:16:relu",
    "decoder:linear:output:identity",
    "branch_encoder:linear:branch_hidden:relu",
    "branch_encoder:linear:latent:relu",
    "branch_decoder:linear:branch_hidden:relu",
    "branch_decoder:linear:output:identity",
    "fusion_encoder:linear:fusion_hidden:relu",
    "fusion_encoder:linear:latent:relu",
    "fusion_decoder:linear:fusion_hidden:relu",
    "fusion_decoder:linear:output:identity"
  ]
}